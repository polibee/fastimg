# Copy this file to deploy/docker/fastimg.env and replace every placeholder.
# This file is consumed by the FastImg API container. It deliberately contains
# no PostgreSQL or Redis service; those services must already exist externally.

APP_NAME=FastImg
APP_ENV=production
APP_DEBUG=false
APP_URL=https://img.example.com
APP_HOST=0.0.0.0
APP_PORT=8080
APP_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ALLOWED_ORIGINS=https://img.example.com

DB_CONNECTION=postgres
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_DATABASE=fastimg
DB_USERNAME=fastimg
DB_PASSWORD=replace-with-the-database-password
DB_SSLMODE=verify-full

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-the-redis-password

# Host port for the web container. Keep this different when another project
# already occupies 8080.
FASTIMG_WEB_PORT=8080
